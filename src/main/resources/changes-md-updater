#!/bin/bash
export LC_ALL=en_US.UTF-8

# Konfiguration
BASE_URL="https://deine-instanz.atlassian.net/wiki"
PAGE_ID="123456789"
PAT="dein-personal-access-token"

# Aktuelle Version der Seite holen
CURRENT=$(curl -s \
  -H "Authorization: Bearer ${PAT}" \
  -H "Accept: application/json" \
  "${BASE_URL}/rest/api/content/${PAGE_ID}?expand=version,body.storage")

# Version und Titel extrahieren
VERSION=$(echo "$CURRENT" | awk -F'"number":' '{print $2}' | awk -F'[^0-9]' '{print $1}')
TITLE=$(echo "$CURRENT" | awk -F'"title":"' '{print $2}' | awk -F'"' '{print $1}')
NEW_VERSION=$((VERSION + 1))

# Neuer Seiteninhalt
NEW_BODY="<p>Aktualisiert am $(date '+%Y-%m-%d %H:%M:%S')</p>"

# Seite aktualisieren
curl -s -X PUT \
  -H "Authorization: Bearer ${PAT}" \
  -H "Content-Type: application/json" \
  "${BASE_URL}/rest/api/content/${PAGE_ID}" \
  -d @- <<EOF
{
  "version": { "number": ${NEW_VERSION} },
  "title": "${TITLE}",
  "type": "page",
  "body": {
    "storage": {
      "value": "${NEW_BODY}",
      "representation": "storage"
    }
  }
}
EOF