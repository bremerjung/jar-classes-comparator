<?xml version="1.0" encoding="UTF-8"?>
<!--
  IT-Szenario 01 – Geänderte Datei
  ─────────────────────────────────
  Das Fixture-JAR enthält com/example/Foo.class mit dem Inhalt
  "old bytecode". Im src/main/java liegt eine neue Version von Foo.java.
  Nach dem Kompilieren weicht target/classes/com/example/Foo.class vom
  JAR ab → das Hotpatch-ZIP muss genau diese eine Datei enthalten.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.it</groupId>
  <artifactId>scenario-01-changed-file</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      compareVersion verweist auf das "release" Artefakt im lokalen Repo,
      das aus dem Fixture-JAR installiert wird (s. maven-install-plugin unten).
    -->
    <hotpatch.compareVersion>1.0.0</hotpatch.compareVersion>
  </properties>

  <build>
    <plugins>

      <!--
        Schritt 1: Das Fixture-JAR (fixture.jar) als Artefakt
        com.example.it:scenario-01-changed-file:1.0.0 ins lokale Repo
        installieren, damit das Hotpatch-Plugin es per Aether auflösen kann.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.1</version>
        <executions>
          <execution>
            <id>install-fixture-jar</id>
            <phase>initialize</phase>
            <goals><goal>install-file</goal></goals>
            <configuration>
              <file>${project.basedir}/fixture.jar</file>
              <groupId>com.example.it</groupId>
              <artifactId>scenario-01-changed-file</artifactId>
              <version>1.0.0</version>
              <packaging>jar</packaging>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Schritt 2: Das Hotpatch-Plugin ausführen.
        compareVersion=1.0.0 → wird das soeben installierte Fixture-JAR
        als Vergleichsbasis heranziehen.
      -->
      <plugin>
        <groupId>com.example.maven</groupId>
        <artifactId>hotpatch-maven-plugin</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <executions>
          <execution>
            <goals><goal>make-hotpatch</goal></goals>
          </execution>
        </executions>
        <configuration>
          <compareVersion>${hotpatch.compareVersion}</compareVersion>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
